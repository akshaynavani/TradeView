# Copy to .env and export before `dotnet run` (ASP.NET Core reads these as configuration).
# Double underscore (__) maps to the ':' section separator.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# SQLite database file (default). Any EF Core SQLite connection string works.
ConnectionStrings__TradeView=Data Source=tradeview.db

# Simulated market data feed
MarketData__PollIntervalSeconds=2
MarketData__VolatilityPercent=0.5
MarketData__SeedInstruments=true
MarketData__TickRetentionHours=24
